{
  "name": "grid",
  "version": "0.1.0",
  "description": "Grid: a desktop app for browsing and streaming movies and TV series",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:e2e": "tsc -p e2e/tsconfig.json",
    "e2e:services": "node e2e/support/serve.ts",
    "build:e2e": "node e2e/build.ts",
    "build:e2e:live": "node e2e/build.ts --live",
    "test:e2e": "npm run build:e2e && npm run test:e2e:run",
    "test:e2e:run": "wdio run e2e/wdio.conf.ts",
    "build:e2e:native": "node e2e/build.ts --native",
    "test:e2e:native": "npm run build:e2e:native && npm run test:e2e:native:run",
    "test:e2e:native:run": "wdio run e2e/wdio.native.conf.ts",
    "test:e2e:render:run": "wdio run e2e/wdio.render.conf.ts",
    "test:e2e:live": "npm run build:e2e:live && wdio run e2e/wdio.live.conf.ts",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:frontend": "vitest run",
    "test:frontend:cov": "vitest run --coverage",
    "test:backend": "cd src-tauri && cargo test",
    "test:backend:cov": "cd src-tauri && cargo llvm-cov",
    "setup:libmpv": "node scripts/setup-libmpv.mjs",
    "bundle:linux": "LD_LIBRARY_PATH=src-tauri/lib/linux-runtime tauri build --bundles deb,rpm,appimage"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.5",
    "serialize-javascript": "^7.1.1"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
